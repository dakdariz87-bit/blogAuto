{
  "manifest_version": 3,
  "name": "블로그 초안 입력 테스트",
  "version": "0.3.0",
  "description": "기존 크롬 로그인으로 네이버의 빈 글에 검토한 초안을 입력합니다. 발행은 직접 확인합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "블로그 초안 입력"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
